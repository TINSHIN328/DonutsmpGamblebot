# ============================================================
# DonutSMP Discord Bot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Discord ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_guild_id_here
ADMIN_ROLE_ID=your_admin_role_id_here

# --- Minecraft Server ---
MC_HOST=play.donutsmp.net
MC_PORT=25565
MC_USERNAME=your_microsoft_account_email
MC_AUTH=microsoft

# --- Database ---
DATABASE_PATH=./data/database.sqlite

# --- Database Backups ---
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_INTERVAL_HOURS=6
DATABASE_BACKUP_RETENTION_DAYS=7

# --- Economy ---
GAME_TAX_PERCENT=15
WITHDRAW_TAX_PERCENT=10
MIN_BET=1000
MAX_BET=100000000
HOUSE_EDGE_PERCENT=0
BIG_WIN_THRESHOLD=100000000
STARTING_BALANCE=1000000

# --- Anti-Abuse ---
MAX_DAILY_WAGER=500000000
MAX_WITHDRAW_PER_DAY=100000000
WITHDRAW_COOLDOWN_SECONDS=300
COINFLIP_COOLDOWN_SECONDS=5
GENERAL_COOLDOWN_SECONDS=3

# --- Rewards ---
RAKEBACK_PERCENT=0.1
INVITE_REWARD_AMOUNT=50000

# --- Bot ---
LOG_LEVEL=info
NODE_ENV=production
